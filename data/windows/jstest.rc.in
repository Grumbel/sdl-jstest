//
// Icon (gamepkgstd INT-10) and version information (INT-11) of
// @PROG@.exe; configured by CMakeLists.txt.

#include <winver.h>

IDI_ICON1 ICON "@ICO_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @RC_VERSION@
PRODUCTVERSION @RC_VERSION@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Ingo Ruhnke"
      // Task Manager shows FileDescription as the process name.
      VALUE "FileDescription", "@DISPLAY_NAME@"
      VALUE "FileVersion", "@PROJECT_VERSION_FULL@"
      VALUE "InternalName", "@PROG@"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "@PROG@.exe"
      VALUE "ProductName", "@DISPLAY_NAME@"
      VALUE "ProductVersion", "@PROJECT_VERSION_FULL@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
