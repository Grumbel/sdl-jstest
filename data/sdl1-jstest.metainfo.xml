<component type="desktop-application">
  <id>sdl1-jstest</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>SDL1 Joystick Test</name>
  <summary>Test joysticks through SDL 1.2</summary>
  <description>
    <p>Shows the joysticks SDL 1 detects, with their axes, buttons, hats and balls, and displays their state and events live, the way games built with SDL 1 see them.</p>
    <p>Especially useful to check an <code>SDL_LINUX_JOYSTICK</code> configuration or how sdl12-compat presents a device to old games.</p>
  </description>
  <launchable type="desktop-id">sdl1-jstest.desktop</launchable>
  <url type="homepage">https://github.com/grumbel/sdl-jstest</url>
  <url type="bugtracker">https://github.com/grumbel/sdl-jstest/issues</url>
  <developer>
    <name>Ingo Ruhnke</name>
  </developer>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/grumbel/sdl-jstest/master/doc/screenshots/screenshot-0.3.0.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <provides>
    <binary>sdl1-jstest</binary>
  </provides>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <releases>
    <release version="0.2.2" date="2023-07-11"/>
    <release version="0.2.1" date="2018-07-04"/>
  </releases>
</component>
